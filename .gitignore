# Build outputs, caches and OS noise never enter the product repo.
__pycache__/
*.py[cod]
.DS_Store
*.orig
# Gradle / Xcode build outputs (the builder writes these inside apps/).
.gradle/
build/
# Android packages never enter the repo (they land under ignored build/ dirs).
*.apk
*.xcworkspace/xcuserdata/
DerivedData/
