<!-- SSX3-120 app manifest. Placeholder attribute values are filled from
     manifestPlaceholders in app/build.gradle, and the installed package id
     is its applicationId. -->
<manifest
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Online needs sockets. Without this every socket()/connect() fails
         (EACCES), so no public Android build can reach a lobby. Normal
         permission: granted at install. -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application android:name=".RunnerApplication"
        android:label="${ps2xAppLabel}"
        android:hasCode="true"
        android:isGame="true"
        android:appCategory="game">

        <!-- F8 (appsec-fix-1): shell-profileable only for lab/dev builds
             (-Pps2xDev=ON); public builds substitute false and drop it. -->
        <profileable android:shell="${ps2xProfileable}" />

        <!-- GPU2: opt in to Android Game Mode (performance + battery); no
             downscaling or fps override, so the OS can't change our render
             size or frame rate. -->
        <meta-data android:name="android.game_mode_config"
            android:resource="@xml/game_mode_config" />

        <!-- F6 (appsec-fix-1): non-exported so only the LaunchActivity
             trampoline (via the exported LaunchAdb bootstrap alias and the
             single Launch120 launcher alias) can start the runtime with its
             RAM/panel policy and 60/120 selection. Tooling bootstraps
             through the LaunchAdb alias. singleTask: one runtime per
             process; a relaunch brings the running game forward. -->
        <!-- Landscape only; rotation, resize and keyboard/navigation changes
             are handled in process instead of restarting the activity. -->
        <activity android:name="android.app.NativeActivity" android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenLayout|screenSize"
            android:launchMode="singleTask"
            android:exported="false">

            <!-- NativeActivity loads lib<value>.so: the engine's ps2EntryRunner target. -->
            <meta-data android:name="android.app.lib_name" android:value="ps2EntryRunner" />
        </activity>

        <!-- TG1: single launcher entry aliasing the trampoline (see
             LaunchActivity.java). The chosen mode persists in the app
             files dir (launch-hz, default 120) and the 120 mode layers
             files/full120.env. Own empty affinity + excludeFromRecents so
             Recents shows only the game task. -->
        <activity android:name=".LaunchActivity"
            android:theme="@android:style/Theme.NoDisplay"
            android:taskAffinity=""
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:exported="false" />

        <activity-alias
            android:name=".Launch120"
            android:label="${ps2xAppLabel}"
            android:enabled="${ps2xAliasEnabled}"
            android:icon="@mipmap/ic_ssx_120"
            android:roundIcon="@mipmap/ic_ssx_120"
            android:exported="true"
            android:targetActivity=".LaunchActivity">
            <!-- MAIN + LAUNCHER: this alias is the app's home-screen icon. -->
            <intent-filter><action android:name="android.intent.action.MAIN" /><category android:name="android.intent.category.LAUNCHER" /></intent-filter>
        </activity-alias>

        <!-- v0-builder-fix-1 S2: always-enabled bootstrap alias with no
             launcher entry. Custom app-id builds disable both launcher
             icons, so the installer stages through this alias first; it is
             never a launcher icon (no intent-filter) and never hidden. -->
        <activity-alias
            android:name=".LaunchAdb"
            android:enabled="true"
            android:targetActivity=".LaunchActivity"
            android:exported="true" />

        <!-- TKM1: the TKO1 "SSX 3 · Tricky" launcher entry is gone (Brad
             10-11). The Tricky layer is always on in the base env and entered
             from the game's main menu, as on iOS. -->
    </application>

</manifest>
