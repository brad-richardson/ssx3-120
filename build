#!/bin/sh
# SPDX-License-Identifier: GPL-3.0-or-later OR MIT
# ssx3-120 one-command builder (builder-ux-1).
#
# Prerequisites: `uv` plus a host toolchain (git, CMake, Ninja,
# pkg-config, a C/C++ compiler, make, bison and flex). `doctor` checks
# the toolchain and prints the exact install line when something is
# missing. Everything else (Python, the font-pack libraries, and -- with
# the android one-command -- the JDK and Android SDK/NDK) is provisioned
# by the builder itself:
#
#   ./build android --ssx3-iso ~/SSX3.iso --work ~/ssx3-work --accept-android-licenses
#
# Step-by-step debugging path: python3 build.py <step> --help.
set -eu

here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)

if ! command -v uv >/dev/null 2>&1; then
    echo "error: 'uv' is required to run the ssx3-120 builder." >&2
    echo "install it with:" >&2
    echo "  curl -LsSf https://astral.sh/uv/install.sh | sh" >&2
    exit 1
fi

# The pinned interpreter comes from uv's managed Pythons, never the host:
# only-managed keeps a stray system Python from silently substituting for
# the .python-version pin (override with UV_PYTHON_PREFERENCE if you must).
# --locked runs off the committed build.py.lock instead of re-resolving.
: "${UV_PYTHON_PREFERENCE:=only-managed}"
export UV_PYTHON_PREFERENCE
exec uv run --locked --script "$here/tools/ssx3/build.py" "$@"
