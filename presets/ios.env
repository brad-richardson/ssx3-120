# iOS base settings. Requires locally generated offline VU1 stage.
# Full120 layer is selected by the existing Target 120 setting.
# Every play default below, minus private bits. Deliberately NOT carried over:
# the I26 auto-route PS2X_PAD_SCRIPT(_CLOCK) (lab route content), and the
# remaster-pack rows (bring your own art; the builder appends a font-pack
# when you build one). Tricky guards ship (no-ops on stock). Intro movies
# are skipped like play (PS2X_SKIP_MOVIE=1, audit item 9); the raw dev
# default stays off.
PS2X_BOOT_ELF=${BUNDLE}/SLUS_207.72
PS2X_CD_IMAGE=${BUNDLE}/SSX3.iso
PS2X_MC_ROOT=${DOCUMENTS}/mc0
PS2X_DEINTERLACE=weave
PS2X_GS_BACKEND=external
PS2X_GS_EXTERNAL_LIBRARY=builtin
GE1_GS_DATA_DIR=${DOCUMENTS}
GE1_TFX_PREWARM=${BUNDLE}/tfx-selectors.bin
PS2X_PGS_SSAA=4
PS2X_PGS_HIRES_SCANOUT=1
PS2X_PRESENT_ZERO_COPY=1
PS2X_SOUND=1
PS2X_MTVU=1
PS2X_VU1_ENGINE=offline
PS2X_GS_HANDOFF_DIET=1
PGS_SKIP_COMPILATION_TASKS=1
PS2X_VU0_RECOMP=1
PS2X_VU0_DIRECT=1
PS2X_MTVU_GIF_STAGE=1
PS2X_MTVU_VIF_STAGE=1
GE1_DRAW_BUFFERING=1
PS2X_GE1_EXPORT_SIZE=display
# Resolution is owned by the settings panel + device tier (public-parity-2 G3,
# Brad 10-17: capable iOS gets Screen on 1080p else 2x). GE1_UPSCALE=auto arms
# the tier resolver (release-pb71-1: unset skips it and the renderer falls
# back to 1x); a saved panel choice still wins because it isn't 'auto'.
GE1_UPSCALE=auto
PS2X_MTVU_FINISH_EE=1
PS2X_MTVU_VIF1_STAT_FREE=1
PS2X_GS_FINISH_TIMING=pcsx2
PS2X_MICROVU_FLAG_HACK=1
PS2X_AUDIO_RESAMPLE=sinc
PS2X_VIF1_REVERSE_DMA=lagF
PS2X_PRESENT_OWNERSHIP=1
GE1_GKV1_SHIFT0=1
GE1_CAS=0.25
PS2X_TURBO_BOOT=1
# Play = public (Brad 10-17; audit item 9): skip intro movies like the play
# envs do. The raw dev default stays off.
PS2X_SKIP_MOVIE=1
# F5 (appsec-fix-1): no pad/session snapshots by default in the public
# preset; recording is an explicit troubleshooting choice (set
# PS2X_PAD_RECORD_DIR/PS2X_PAD_RECORD_KEEP in your env to opt in).
PS2X_AUTOSAVE=1
PS2X_AUTOSAVE_AUTORESUME_S=0
# Target-120-off is plain stock 60 (split120 retired); lean offline scan.
PS2X_OM1_LEAN=1
PS2X_OM1_SCAN=1
# Playtest perf log (Documents/perf/, ring-capped): play+measure builds.
PS2X_PERF_LOG=1
# GS handoff low-water (platform-generic, live on iOS).
PS2X_GS_WAKE_LOWWATER=4096
# Park the MTVU stage producer waits after a 4 us spin.
PS2X_MTVU_STAGE_PARK2=1
# Native static world (terrain + scenery instances at MSCAL).
PS2X_SSX3_NATIVE_WORLD=terrain,instances
# Specialized VIF UNPACK decoders.
PS2X_VIF_UNPACK_FAST=1
# Zero-copy GIF batches (needs GIF_BATCH=1).
PS2X_GS_GIF_BATCH=1
PS2X_GS_GIF_ARENA=1
# On-device upscale (no AI art): provider Lanczos/raster-edge versions show.
GE1_ONDEVICE_UPSCALE=1
# Public online defaults (same as the Android preset): network on, public
# lobby hostname, one-tap Quick Play prefill + online arming, and the
# Brad 10-17 STOCK120 race path (D:37,41).
PS2X_NET=1
PS2X_NET_SERVER=ssx.bradr.dev
PS2X_NET_QUICKPLAY=1
PS2X_NET_QUICKPLAY_NAV=online
PS2X_NET_STOCK120=1
# SET2 Select+Start settings overlay (matches the Android preset).
PS2X_SETTINGS_OVERLAY=1
# TK39 HLE pools to low RAM, guest heap ceiling 0x1F31000 (matches Android).
PS2X_HLE_POOLS_LOW=1
# OBE1 OM1 cert elision (19.8% jobs elided, 0 misses; builder-generated stage).
PS2X_OM1_CERT=1
# GSW1 Tricky HUD async composite on the GsHud helper thread (matches Android).
PS2X_TRICKY_HUD_ASYNC=1
# HUD5 Tricky HUD composite on GE1's queue (mode-gated, stock untouched).
PS2X_TRICKY_HUD_GPU=1
# Tricky-course guards, always on. Each is a no-op on stock courses
# (TK15/TK15c/TK34/TK38), so a stock-only build arms nothing. The
# Tricky-only rows live in the staged tricky.env layer owned by tk-build-1.
# TK15 terrain patch-cache guard; no-op on stock.
PS2X_SSX3_PATCH_CACHE_GUARD=1
# TK15c/TK22 draw-table guard; no-op on stock.
PS2X_SSX3_DRAWTABLE_GUARD=2
# TK34 lazy type-1 patch-cache grow.
PS2X_SSX3_PATCH_CACHE_GROW=1
# TK38 camera spatial-query list guard.
PS2X_SSX3_SPATIAL_LIST_GUARD=1
