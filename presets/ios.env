# iOS base settings. Requires locally generated offline VU1 stage.
# Full120 layer is selected by the existing Target 120 setting.
# Reconciled 2026-10-17 (ios-builder-1) with the lab play env
# (local/tooling/build/ios/ps2x.env): every signed-off play default below,
# minus private bits. Deliberately NOT carried over: PS2X_SKIP_MOVIE
# (dev-only bypass, default off), the I26 auto-route PS2X_PAD_SCRIPT(_CLOCK)
# (lab route content), and the remaster-pack rows (bring your own art; the
# builder appends a font-pack when you build one). Tricky, achievements and
# the TFX bundled coverage ship (all fail closed without their files).
PS2X_BOOT_ELF=${BUNDLE}/SLUS_207.72
PS2X_CD_IMAGE=${BUNDLE}/SSX3.iso
PS2X_MC_ROOT=${DOCUMENTS}/mc0
PS2X_DEINTERLACE=weave
PS2X_GS_BACKEND=external
PS2X_GS_EXTERNAL_LIBRARY=builtin
GE1_GS_DATA_DIR=${DOCUMENTS}
PS2X_PGS_SSAA=4
PS2X_PGS_HIRES_SCANOUT=1
PS2X_PRESENT_ZERO_COPY=1
PS2X_SOUND=1
PS2X_MTVU=1
PS2X_VU1_ENGINE=offline
PS2X_GS_HANDOFF_DIET=1
PGS_SKIP_COMPILATION_TASKS=1
PS2X_VU0_RECOMP=1
PS2X_VU0_DIRECT=1
PS2X_MTVU_GIF_STAGE=1
PS2X_MTVU_VIF_STAGE=1
GE1_DRAW_BUFFERING=1
PS2X_GE1_EXPORT_SIZE=display
GE1_UPSCALE=2
PS2X_MTVU_FINISH_EE=1
PS2X_MTVU_VIF1_STAT_FREE=1
PS2X_GS_FINISH_TIMING=pcsx2
PS2X_MICROVU_FLAG_HACK=1
PS2X_AUDIO_RESAMPLE=sinc
PS2X_VIF1_REVERSE_DMA=lagF
PS2X_PRESENT_OWNERSHIP=1
GE1_GKV1_SHIFT0=1
PS2X_QUICKSTATE_UI=1
GE1_CAS=0.25
PS2X_TURBO_BOOT=1
PS2X_INPUT_MARKER=1
PS2X_PAD_RECORD_DIR=${DOCUMENTS}/padrec
PS2X_PAD_RECORD_KEEP=10
PS2X_AUTOSAVE=1
PS2X_AUTOSAVE_AUTORESUME_S=0
# Target-120-off is plain stock 60 (split120 retired); lean offline scan.
PS2X_OM1_LEAN=1
PS2X_OM1_SCAN=1
# Playtest perf log (Documents/perf/, ring-capped): play+measure builds.
PS2X_PERF_LOG=1
# GS handoff low-water (platform-generic, live on iOS).
PS2X_GS_WAKE_LOWWATER=4096
# Park the MTVU stage producer waits after a 4 us spin.
PS2X_MTVU_STAGE_PARK2=1
# Native static world (terrain + scenery instances at MSCAL).
PS2X_SSX3_NATIVE_WORLD=terrain,instances
# Specialized VIF UNPACK decoders.
PS2X_VIF_UNPACK_FAST=1
# Zero-copy GIF batches (needs GIF_BATCH=1).
PS2X_GS_GIF_BATCH=1
PS2X_GS_GIF_ARENA=1
# On-device upscale (no AI art): provider Lanczos/raster-edge versions show.
GE1_ONDEVICE_UPSCALE=1
# Public online defaults (same as the Android preset): network on, public
# lobby hostname, one-tap Quick Play prefill + online arming.
PS2X_NET=1
PS2X_NET_SERVER=ssx.bradr.dev
PS2X_NET_QUICKPLAY=1
PS2X_NET_QUICKPLAY_NAV=online
# SET2 Select+Start settings overlay (matches the Android preset).
PS2X_SETTINGS_OVERLAY=1
# TK39 HLE pools to low RAM, guest heap ceiling 0x1F31000 (matches Android).
PS2X_HLE_POOLS_LOW=1
# OBE1 OM1 cert elision (19.8% jobs elided, 0 misses; needs a user stage).
PS2X_OM1_CERT=1
# GSW1 Tricky HUD async composite on the GsHud helper thread (matches Android).
PS2X_TRICKY_HUD_ASYNC=1
# HUD5 Tricky HUD composite on GE1's queue (mode-gated, stock untouched).
PS2X_TRICKY_HUD_GPU=1
# ACH2 (idle with no achievements-set file in Documents).
PS2X_ACHIEVEMENTS=1
# PCF1 bundled Metal coverage: unions the shipped-in-library selectors with a
# user-recorded file; absent file = shipped coverage only (fail closed).
GE1_TFX_PREWARM=${DOCUMENTS}/tfx-selectors.bin
# Tricky layer, always on (IPB40 RC Tricky ON). Files are bundled in the app
# (.app/tricky/); stock-course inertness per IPB24. Without the Tricky bundle
# each row fails closed (manifest/overlay refusal = stock).
# TK3 overlay dir.
PS2X_CD_OVERLAY=${BUNDLE}/tricky/tricky-ov
# TK2 course manifest.
PS2X_SSX3_COURSE_MANIFEST=${BUNDLE}/tricky/m-tricky.txt
# TK7 picker (IPB40).
PS2X_SSX3_COURSE_PICKER=1
# TK11 Tricky frontend entry.
PS2X_SSX3_TRICKY_MENU=1
# TK15 terrain patch-cache guard; no-op on stock.
PS2X_SSX3_PATCH_CACHE_GUARD=1
# TK15c/TK22 draw-table guard; no-op on stock.
PS2X_SSX3_DRAWTABLE_GUARD=2
# TK34 lazy type-1 patch-cache grow.
PS2X_SSX3_PATCH_CACHE_GROW=1
# TK38 camera spatial-query list guard.
PS2X_SSX3_SPATIAL_LIST_GUARD=1
# TKP4b TRICKY meter HUD (mode-gated; stock output byte-identical).
PS2X_SSX3_TRICKY_HUD=1
# TK43a HUD atlas (bundled trickyhud.bin, built from the Tricky ISO).
PS2X_SSX3_TRICKY_HUD_ART=${BUNDLE}/tricky/trickyhud.bin
# tk-banner-1 boot-scoped race-banner composite (bundled).
PS2X_SSX3_TRICKY_MUSIC_INF=${BUNDLE}/tricky/music-inf-tricky-big
# TK43c It's Tricky meter-full bursts (bundled WAV, output-only).
PS2X_SSX3_TRICKY_SONG=${BUNDLE}/tricky/tricky-song.wav
# TK45c gem multipliers (zero writes on stock courses).
PS2X_SSX3_TRICKY_GEMS=1
# TK45c gem sidecar (bundled tricky-gems.tsv).
PS2X_SSX3_TRICKY_GEMS_TABLE=${BUNDLE}/tricky/tricky-gems.tsv
# TLS1 Tricky-only draw distance (mode-gated, stock untouched).
PS2X_SSX3_TRICKY_LOD_SCALE=0.8
# RSV1 donor reset surfaces via the SSX 3 path (stock: no lookup).
PS2X_SSX3_TRICKY_RESETVOL=1
# RSV1 reset sidecar (bundled tricky-resetvol.tsv).
PS2X_SSX3_TRICKY_RESETVOL_TABLE=${BUNDLE}/tricky/tricky-resetvol.tsv
# MGX1 Megaplex only (stock races keep their lap path).
PS2X_SSX3_MEGA_LAPS=1
# tk-audio-1 DJ gate (IPB40 Tricky audio stack).
PS2X_SSX3_TRICKY_DJ_GATE=1
# tk-announcer-1 Tricky MC translator (IPB40 Tricky audio stack).
PS2X_SSX3_TRICKY_MC=1
