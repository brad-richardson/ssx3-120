# Online layer: Quick Play lobby defaults (optional layer over ps2x.env).
# This file is the single place naming the default public lobby.
# To point at another lobby (yours or a friend's), set in your env:
#   PS2X_NET_SERVER=<hostname-or-IPv4>  (PS2X_NET=1 arms the HLE)
# Explicit env wins over this file; unset PS2X_NET to stay offline.
# iOS carries the same four rows inline in presets/ios.env; the Android
# stage() appends this file to the staged ps2x.env (appsec-fix-1).
PS2X_NET=1
PS2X_NET_SERVER=ssx.bradr.dev
PS2X_NET_QUICKPLAY=1
PS2X_NET_QUICKPLAY_NAV=online
