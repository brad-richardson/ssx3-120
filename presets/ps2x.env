# Android base preset for a local SSX 3 build (shipped with tools/ssx3).
# Derived from the Odin play env with every private path removed: no host
# paths, no personal card, no remaster pack, no telemetry or pad records.
# Tricky and achievements rows ship (both fail closed without their files).
# The SET2 settings overlay is on.
# Place it with: build.py install (SHA checked; preserves cards).
# Online returns with 120 netplay (Brad 10-16).
PS2X_CD_IMAGE=/storage/emulated/0/Android/data/com.ssx3.recomp/files/SSX3.iso
PS2X_MC_ROOT=/storage/emulated/0/Android/data/com.ssx3.recomp/files/mc0
PS2X_SETTINGS_OVERLAY=1
GE1_VK_TURNIP=auto
PS2X_AUDIO_RESAMPLE=sinc
PS2X_VIF1_REVERSE_DMA=lagF
GE1_UPSCALE=auto
PS2X_GE1_EXPORT_SIZE=auto
GE1_CAS=auto
PS2X_GS_WAKE_LOWWATER=4096
PS2X_MTVU_STAGE_PARK2=1
# device-gates-1 (H5): TU_AUTOTUNE_ALGO left to the GPU-aware backend, which
# sets prefer_sysmem only when the bundled Turnip serves an Adreno 8xx
# (TUR1: Elysium -0.75 p50/-2.0 p99, pixels identical). Explicit env wins.
WAIT_SPIN_MICROSECONDS=5
PS2X_GS_GIF_BATCH=1
PS2X_GS_GIF_ARENA=1
PS2X_SSX3_NATIVE_WORLD=terrain,instances
PS2X_VIF_UNPACK_FAST=1
GE1_ADRENO_SRC1_REWRITE=1
GE1_MERGE_SKIP=1
GE1_EXPORT_DIRECT=1
PS2X_PRESENT_PREROTATE=2
PS2X_PRESENT_AHB_POOL=6
PS2X_TURBO_BOOT=1
# Signed-off play policy (matches the play device env): heap ceiling
# 0x01F31000, Tricky HUD async composite (inert off Tricky courses),
# host-only lost-input marker, lifecycle autosave + silent resume.
PS2X_HLE_POOLS_LOW=1
PS2X_TRICKY_HUD_ASYNC=1
PS2X_INPUT_MARKER=1
PS2X_AUTOSAVE=1
PS2X_AUTOSAVE_AUTORESUME_S=0
# PB66 (Brad 10-15 ship ON; decisions.md Upscale defaults 10-17, all devices).
GE1_ONDEVICE_UPSCALE=1
# ACH2 (Brad 10-04 achievements on phone; idle with no achievements-set file).
PS2X_ACHIEVEMENTS=1
# Tricky layer, always on from this base env (PB58/TKM1; PB70 RC Tricky ON).
# Runtime names and device files match tk-build-1's staged public layer
# (TRICKY_DEVICE_FILES/TREES beside ps2x.env; stage rewrites com.ssx3.recomp
# to the built id). Stock-only installs fail closed (manifest/overlay refusal
# serves the disc as is). 120 launches never layer tricky.env, so the base
# carries these (ps2_android_runtime.cpp TKO1/TG1).
# TK3 overlay dir.
PS2X_CD_OVERLAY=/storage/emulated/0/Android/data/com.ssx3.recomp/files/tricky-ov
# TK2 course manifest.
PS2X_SSX3_COURSE_MANIFEST=/storage/emulated/0/Android/data/com.ssx3.recomp/files/m-tricky.txt
# TK7 picker (PB70).
PS2X_SSX3_COURSE_PICKER=1
# TK11 Tricky frontend entry.
PS2X_SSX3_TRICKY_MENU=1
# TK15 terrain patch-cache guard (Aloha, Elysium); no-op on stock.
PS2X_SSX3_PATCH_CACHE_GUARD=1
# TK15c/TK22 draw-table guard (Elysium); no-op on stock.
PS2X_SSX3_DRAWTABLE_GUARD=2
# TK34 lazy type-1 patch-cache grow.
PS2X_SSX3_PATCH_CACHE_GROW=1
# TK38 camera spatial-query list guard.
PS2X_SSX3_SPATIAL_LIST_GUARD=1
# TKP4b TRICKY meter HUD (Tricky courses only).
PS2X_SSX3_TRICKY_HUD=1
# TK43a HUD atlas, built from the Tricky ISO (staged trickyhud.bin).
PS2X_SSX3_TRICKY_HUD_ART=/storage/emulated/0/Android/data/com.ssx3.recomp/files/trickyhud.bin
# TK43c It's Tricky meter-full bursts (staged WAV, output-only).
PS2X_SSX3_TRICKY_SONG=/storage/emulated/0/Android/data/com.ssx3.recomp/files/tricky-song.wav
# TK45c gem multipliers (sidecar; inert on stock).
PS2X_SSX3_TRICKY_GEMS=1
# TK45c gem sidecar (staged tricky-gems.tsv).
PS2X_SSX3_TRICKY_GEMS_TABLE=/storage/emulated/0/Android/data/com.ssx3.recomp/files/tricky-gems.tsv
# TLS1 Tricky-only draw distance (PB44 feel test, mode-gated).
PS2X_SSX3_TRICKY_LOD_SCALE=0.8
# RSV1 donor reset surfaces through the SSX 3 path (Brad 10-11).
PS2X_SSX3_TRICKY_RESETVOL=1
# RSV1 reset sidecar (staged tricky-resetvol.tsv).
PS2X_SSX3_TRICKY_RESETVOL_TABLE=/storage/emulated/0/Android/data/com.ssx3.recomp/files/tricky-resetvol.tsv
# MGX1 Megaplex gems + three laps (Brad 10-11).
PS2X_SSX3_MEGA_LAPS=1
# tk-audio-1 DJ gate (PB70 Tricky audio stack).
PS2X_SSX3_TRICKY_DJ_GATE=1
# tk-announcer-1 Tricky MC translator (PB70 Tricky audio stack).
PS2X_SSX3_TRICKY_MC=1
# TRICKY_MUSIC_INF is supplied by the staged tricky.env layer (its composite
# filename is driver-defined at tk-build-1); not guessed here.
# HUD4 Part 2 GPU HUD composite (GsHud 3.5 -> 0.13 ms/f; <= 1 level).
PS2X_TRICKY_HUD_GPU=1
