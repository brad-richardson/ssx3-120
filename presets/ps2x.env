# Android base preset for a local SSX 3 build (shipped with tools/ssx3).
# Derived from the Odin play env with every private path removed: no host
# paths, no personal card, no remaster pack, no telemetry or pad records.
# Tricky guards ship (inert without their content).
# The SET2 settings overlay is on.
# Place it with: build.py install (SHA checked; preserves cards).
# Online returns with 120 netplay (Brad 10-16).
PS2X_CD_IMAGE=/storage/emulated/0/Android/data/com.ssx3.recomp/files/SSX3.iso
PS2X_MC_ROOT=/storage/emulated/0/Android/data/com.ssx3.recomp/files/mc0
PS2X_SETTINGS_OVERLAY=1
GE1_VK_TURNIP=auto
PS2X_AUDIO_RESAMPLE=sinc
PS2X_VIF1_REVERSE_DMA=lagF
GE1_UPSCALE=auto
PS2X_GE1_EXPORT_SIZE=auto
GE1_CAS=auto
PS2X_GS_WAKE_LOWWATER=4096
PS2X_MTVU_STAGE_PARK2=1
# device-gates-1 (H5): TU_AUTOTUNE_ALGO left to the GPU-aware backend, which
# sets prefer_sysmem only when the bundled Turnip serves an Adreno 8xx
# (TUR1: Elysium -0.75 p50/-2.0 p99, pixels identical). Explicit env wins.
WAIT_SPIN_MICROSECONDS=5
PS2X_GS_GIF_BATCH=1
PS2X_GS_GIF_ARENA=1
PS2X_SSX3_NATIVE_WORLD=terrain,instances
PS2X_VIF_UNPACK_FAST=1
GE1_ADRENO_SRC1_REWRITE=1
GE1_MERGE_SKIP=1
GE1_EXPORT_DIRECT=1
PS2X_PRESENT_PREROTATE=2
PS2X_PRESENT_AHB_POOL=6
PS2X_TURBO_BOOT=1
# Signed-off play policy (matches the play device env): heap ceiling
# 0x01F31000, Tricky HUD async composite (inert off Tricky courses),
# host-only lost-input marker, lifecycle autosave + silent resume.
PS2X_HLE_POOLS_LOW=1
PS2X_TRICKY_HUD_ASYNC=1
PS2X_INPUT_MARKER=1
PS2X_AUTOSAVE=1
PS2X_AUTOSAVE_AUTORESUME_S=0
# PB66 (Brad 10-15 ship ON; decisions.md Upscale defaults 10-17, all devices).
GE1_ONDEVICE_UPSCALE=1
# Tricky-course guards, always on (PB58/TKM1 base-env Tricky). Each is a
# no-op on stock courses (TK15/TK15c/TK34/TK38), so a stock-only build
# (no Tricky disc) arms nothing. The Tricky-only rows (overlay, manifest,
# picker, menu, HUD, song, gems, LOD, resetvol, laps, DJ/MC) live in the
# staged tricky.env layer owned by tk-build-1, generated only when the
# Tricky layer is built.
# TK15 terrain patch-cache guard (Aloha, Elysium); no-op on stock.
PS2X_SSX3_PATCH_CACHE_GUARD=1
# TK15c/TK22 draw-table guard (Elysium); no-op on stock.
PS2X_SSX3_DRAWTABLE_GUARD=2
# TK34 lazy type-1 patch-cache grow (RAM-identical until first empty pop).
PS2X_SSX3_PATCH_CACHE_GROW=1
# TK38 camera spatial-query list guard (stock stays far below caps).
PS2X_SSX3_SPATIAL_LIST_GUARD=1
# HUD4 Part 2 GPU HUD composite (mode-gated; stock untouched).
PS2X_TRICKY_HUD_GPU=1
