# Android full-120 layer, layered over ps2x.env by the "SSX 3 · 120"
# launcher (the 60 launcher reads only ps2x.env). Mirrors the Odin play
# full120 layer; fully close the app before switching layers.
PS2X_SSX3_FULL120=events
PS2X_SSX3_FULL120_FIX=all,jcam,pid,jcam2,ground2,life2,inputchain,trails,query,vnret,shadowpub,groundstep,trailring,sel5,normcap,sel5b,boostfill,stuntchg,flare,asymk
PS2X_DISPLAY_HZ=120
PS2X_PRESENT_PER_VSYNC=1
PS2X_SSX3_FULL120_FASTHOOKS=1
PS2X_VSYNC_LOCK=1
PS2X_VSYNC_LOCK_AUDIO=tempo
PS2X_STRETCH_FEED=demand
